# Resend — contact form email delivery
# Create an API key at https://resend.com/api-keys and add it in Vercel
# (Project → Settings → Environment Variables) as RESEND_API_KEY.
RESEND_API_KEY=

# Optional overrides (defaults shown).
# CONTACT_TO_EMAIL is where contact-form submissions are delivered.
#   Default: hello@imanfocus.app
#   TEMPORARY: until the hello@imanfocus.app mailbox exists, set this in Vercel
#   to a personal inbox (e.g. a Gmail address) to receive/test submissions.
#   Switch it back to hello@imanfocus.app once email hosting is set up.
#   Set the real value in Vercel env vars — do NOT commit a personal address here.
# CONTACT_TO_EMAIL=hello@imanfocus.app
#
# CONTACT_FROM_EMAIL must use a domain verified in Resend (imanfocus.app).
# CONTACT_FROM_EMAIL=ImanFocus Contact <contact@imanfocus.app>

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — ImanFocus waitlist (early-access email capture)
# Project: imanfocus-waitlist  (Supabase Dashboard → Project Settings → API)
# These are PUBLIC values (safe to expose in the browser). Inserts are guarded
# by Row Level Security — see supabase/migrations/0001_waitlist_signups.sql.
# Set the real values in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Google Analytics 4 — page views + waitlist/footer events
# Create a GA4 Web stream for imanfocus.app and copy the Measurement ID (G-…).
# See docs/analytics-setup.md for full setup and event reference.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Clarity — session recordings, heatmaps, scroll maps
# Create a project at https://clarity.microsoft.com for imanfocus.app.
# Project ID: Clarity project → Settings → Overview.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
