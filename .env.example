# Resend — contact form email delivery
# Create an API key at https://resend.com/api-keys and add it in Vercel
# (Project → Settings → Environment Variables) as RESEND_API_KEY.
RESEND_API_KEY=

# Optional overrides (defaults shown).
# CONTACT_TO_EMAIL is where contact-form submissions are delivered.
#   Default: hello@imanfocus.app
#   TEMPORARY: until the hello@imanfocus.app mailbox exists, set this in Vercel
#   to a personal inbox (e.g. a Gmail address) to receive/test submissions.
#   Switch it back to hello@imanfocus.app once email hosting is set up.
#   Set the real value in Vercel env vars — do NOT commit a personal address here.
# CONTACT_TO_EMAIL=hello@imanfocus.app
#
# CONTACT_FROM_EMAIL must use a domain verified in Resend (imanfocus.app).
# CONTACT_FROM_EMAIL=ImanFocus Contact <contact@imanfocus.app>
